---
import type { CollectionEntry } from 'astro:content';
import NotePreview from '../lab-notes/NotePreview.astro';
import ActionLink from '../ui/ActionLink.astro';

interface Props {
  notes: CollectionEntry<'lab-notes'>[];
}

const { notes } = Astro.props;

---

<section class="home-notes">
  <div class="notes-heading">
    <h2>Recent Lab Notes</h2>
    <ActionLink href="/lab-notes/" variant="text">Browse all lab notes</ActionLink>
  </div>
  {notes.length ? (
    <ul class="home-note-list" role="list">
      {notes.map((note) => (
        <li><NotePreview note={note} headingLevel={3} /></li>
      ))}
    </ul>
  ) : (
    <p class="notes-empty">The notebook is open. New writing will appear here when it’s ready to share.</p>
  )}
</section>

<style>
  .home-notes {
    padding-block: var(--space-14);
    color: var(--color-text);
  }

  .notes-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-6);
    margin-block-end: var(--space-8);
  }

  h2 {
    margin: 0;
    font-size: var(--font-size-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    text-wrap: balance;
  }

  .home-note-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes-empty {
    max-width: 70ch;
    margin: 0;
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border-radius: var(--radius-small);
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  @media (max-width: 48rem) {
    .home-notes {
      padding-block: var(--space-10);
    }

    .notes-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
      margin-block-end: var(--space-6);
    }

  }
</style>
