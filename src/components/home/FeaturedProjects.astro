---
import type { CollectionEntry } from "astro:content";
import ActionLink from "../ui/ActionLink.astro";
import ProjectCard from "../projects/ProjectCard.astro";
import { projectPreviewComponents } from "../../config/project-previews";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section class="featured-projects">
  <div class="section-heading">
    <h2>Featured Projects</h2>
    <ActionLink href="/projects/" variant="text">Browse all projects</ActionLink>
  </div>
  {projects.length ? (
    <ul class="project-list" role="list">
      {projects.map((project) => (
        <li>
          <ProjectCard
            project={project}
            headingLevel={3}
            previewComponent={projectPreviewComponents[project.id]}
          />
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty-projects">
      Featured projects will appear here when they’re ready to share.
    </p>
  )}
</section>

<style>
  .featured-projects {
    padding-block: var(--space-12);
    border-block: 1px solid var(--color-border);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-block-end: var(--space-8);
  }

  h2 {
    margin: 0;
    font-size: var(--font-size-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    text-wrap: balance;
  }

  .project-list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty-projects {
    margin: 0;
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border-radius: var(--radius-small);
    color: var(--color-text-muted);
  }

  @media (max-width: 45rem) {
    .featured-projects {
      padding-block: var(--space-8);
    }

    .section-heading {
      padding-block-end: var(--space-6);
    }
  }
</style>
