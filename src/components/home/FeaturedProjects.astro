---
import type { CollectionEntry } from "astro:content";
import ArrowIcon from "../ui/ArrowIcon.astro";
import ProjectCard from "../projects/ProjectCard.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
}

const { projects } = Astro.props;
---

<section id="projects" class="featured-projects" aria-labelledby="featured-projects-title">
  <div class="section-heading">
    <h2 id="featured-projects-title">Featured projects</h2>
    <a class="all-projects" href="/projects">Browse all projects <ArrowIcon /></a>
  </div>
  {
    projects.length ? (
      <ul class="project-list" role="list">
        {projects.map((project) => (
          <li>
            <ProjectCard project={project} headingLevel={3} />
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-projects">
        Featured projects will appear here when they’re ready to share.
      </p>
    )
  }
</section>

<style>
  .featured-projects {
    padding-block: var(--space-12);
    border-block: 1px solid var(--color-border);
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-block-end: var(--space-8);
  }

  h2 {
    margin: 0;
    font-size: var(--font-size-heading);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .all-projects {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--color-text);
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
  }

  .project-list {
    display: grid;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .all-projects:is(:hover, :focus-visible) {
    text-decoration-thickness: 2px;
  }

  .empty-projects {
    margin: 0;
    padding: var(--space-6);
    background: #faf9f6;
    border-radius: var(--space-1);
    color: var(--color-text-muted);
  }

  @media (max-width: 45rem) {
    .featured-projects {
      padding-block: var(--space-8);
    }

    .section-heading {
      padding-block-end: var(--space-6);
    }
  }
</style>
