---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../content/FormattedDate.astro';
import ArrowIcon from '../ui/ArrowIcon.astro';

interface Props {
  note: CollectionEntry<'lab-notes'>;
  headingLevel?: 2 | 3;
  idPrefix?: string;
}

const { note, headingLevel = 2, idPrefix = 'note' } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';

function estimateReadingTime(body: string | undefined): number | undefined {
  const wordCount = body?.match(/\S+/g)?.length ?? 0;
  return wordCount ? Math.ceil(wordCount / 200) : undefined;
}

const readingTime = estimateReadingTime(note.body);
---

<a class="note-link" href={`/lab-notes/${note.id}`} aria-labelledby={`${idPrefix}-${note.id}`}>
  <div class="note-meta">
    <FormattedDate date={note.data.publishedAt} />
    {readingTime && (
      <span class="reading-time" aria-label={`Estimated reading time: ${readingTime} ${readingTime === 1 ? 'minute' : 'minutes'}`}>
        {readingTime} min read
      </span>
    )}
  </div>
  <div class="note-copy">
    <Heading class="note-title" id={`${idPrefix}-${note.id}`}>{note.data.title}</Heading>
    <p class="note-description">{note.data.description}</p>
    {note.data.tags.length > 0 && (
      <ul class="note-topics" role="list" aria-label="Topics">
        {note.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}
  </div>
  <span class="note-arrow"><ArrowIcon /></span>
</a>

<style>
  .note-link {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr) 1rem;
    align-items: baseline;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--color-surface-raised);
    border-radius: var(--space-1);
    color: inherit;
    text-decoration: none;
    transition: background-color var(--motion-duration) var(--motion-ease);
  }

  .note-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    font-variant-numeric: tabular-nums;
  }

  .note-meta :global(time) {
    color: var(--color-text);
  }

  .reading-time {
    padding: var(--space-1) var(--space-2);
    background: var(--color-surface);
    border-radius: var(--space-1);
    white-space: nowrap;
  }

  .note-title {
    margin: 0;
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    line-height: var(--line-height-compact);
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }

  .note-description {
    max-width: 70ch;
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-compact);
    line-height: var(--line-height-body);
  }

  .note-topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
  }

  .note-topics li {
    padding: 0.125rem var(--space-2);
    background: var(--color-surface);
    border-radius: var(--space-1);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
  }

  .note-arrow {
    display: inline-flex;
    color: var(--color-text-muted);
    transition: transform var(--motion-duration) var(--motion-ease);
  }

  .note-link:is(:hover, :focus-visible) {
    background: var(--color-surface);
  }

  .note-link:is(:hover, :focus-visible) .note-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .note-link:is(:hover, :focus-visible) .note-arrow {
    transform: translateX(0.15em);
  }

  @media (max-width: 48rem) {
    .note-link {
      grid-template-columns: minmax(0, 1fr) 1rem;
      gap: var(--space-4) var(--space-3);
      padding: var(--space-6) var(--space-4);
    }

    .note-meta {
      grid-column: 1 / -1;
    }

    .note-copy {
      grid-column: 1;
    }

    .note-arrow {
      grid-column: 2;
      grid-row: 2;
    }
  }
</style>
