---
import { site } from "../../config/site";

const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const isProjects = pathname === "/projects" || pathname.startsWith("/projects/");
const isLabNotes =
  pathname === "/lab-notes" || pathname.startsWith("/lab-notes/");
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.name} home`}>
    <img src="/vomerlabs-logo.svg" alt="" width="125" height="22" />
  </a>
  <nav aria-label="Main navigation">
    <a
      href="/projects"
      aria-current={isProjects
        ? pathname === "/projects"
          ? "page"
          : "true"
        : undefined}>Projects</a
    >
    <a
      href="/lab-notes"
      aria-current={isLabNotes
        ? pathname === "/lab-notes"
          ? "page"
          : "true"
        : undefined}>Lab Notes</a
    >
    <a href="/about" aria-current={pathname === "/about" ? "page" : undefined}
      >About</a
    >
    <a
      href="/contact"
      aria-current={pathname === "/contact" ? "page" : undefined}>Contact</a
    >
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    width: 100%;
    max-width: var(--width-content);
    margin-inline: auto;
    padding: clamp(1rem, 1.3vw, 1.5rem) var(--page-gutter);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    height: 1.2em;
    font-size: clamp(1.5rem, 1.9vw, 1.875rem);
    line-height: var(--line-height-snug);
  }

  .wordmark img {
    display: block;
    width: 5em;
    height: auto;
  }

  nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 2.8vw, 2.75rem);
    color: var(--color-text-muted);
    font-size: var(--font-size-body);
    line-height: 1.3;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: clamp(2.5rem, 2.78vw, 2.75rem);
    text-underline-offset: 0.3em;
  }

  nav a:is(:hover, :focus-visible, [aria-current]) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-focus);
  }

  @media (max-width: 30rem) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      gap: var(--space-2);
    }

    nav {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
