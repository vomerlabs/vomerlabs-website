---
import { site } from '../../config/site';
import ArrowIcon from '../ui/ArrowIcon.astro';

interface Props {
  topHref?: string;
  showDivider?: boolean;
}

const { topHref = '#intro-title', showDivider = false } = Astro.props;
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/lab-notes', label: 'Lab Notes' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
---

<footer id="contact" class="site-footer">
  <div class:list={['footer-top', { 'with-divider': showDivider }]}>
    <div class="footer-studio">
      <a class="footer-wordmark" href="/" aria-label={`${site.name} home`}>
        <img src="/vomerlabs-logo.svg" alt="" width="125" height="22" loading="lazy" />
      </a>
      <p class="studio-description">{site.description}</p>
    </div>
    <nav class="footer-navigation" aria-labelledby="footer-explore-title">
      <h2 id="footer-explore-title">Explore</h2>
      <ul role="list">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="footer-contact">
      <h2>Contact</h2>
      <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>
      <p>A project, a question, or an idea to explore.</p>
    </div>
  </div>
  <div class="colophon">
    <p>© {new Date().getFullYear()} {site.name}</p>
    <a class="back-top" href={topHref}>Back to top <ArrowIcon /></a>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    max-width: var(--width-content);
    margin-inline: auto;
    padding: 0 var(--page-gutter) var(--space-6);
    color: var(--color-text);
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--space-16);
    padding-block: var(--space-12);
  }

  .with-divider {
    border-block-start: 1px solid var(--color-border);
  }

  .footer-wordmark {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
  }

  .footer-wordmark img {
    display: block;
    width: 160px;
    max-width: 100%;
    height: auto;
  }

  .studio-description {
    max-width: 38ch;
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: 1.8;
  }

  h2 {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-body);
    font-weight: 700;
    line-height: 1.4;
  }

  nav ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    text-decoration: none;
    text-underline-offset: 0.3em;
  }

  nav a:is(:hover, :focus-visible) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .footer-email {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: inherit;
    font-size: var(--font-size-body);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    overflow-wrap: anywhere;
  }

  .footer-email:is(:hover, :focus-visible) {
    text-decoration-thickness: 2px;
  }

  .footer-contact p {
    max-width: 28ch;
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: 1.8;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .colophon p {
    margin: 0;
  }

  .back-top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.75rem;
    color: inherit;
    text-decoration: none;
    text-underline-offset: 0.3em;
  }

  .back-top :global(svg) {
    transform: rotate(-90deg);
  }

  .back-top:is(:hover, :focus-visible) {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  @media (max-width: 48rem) {
    .footer-top {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: var(--space-8) var(--space-6);
      padding-block: var(--space-8);
    }

    .footer-studio {
      grid-column: 1 / -1;
    }

    .studio-description {
      max-width: 50ch;
    }

    nav ul {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
