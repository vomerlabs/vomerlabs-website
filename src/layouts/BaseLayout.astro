---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import { site } from '../config/site';
import displayFont from '../assets/fonts/kedebideri-bold.ttf?url';
import ContactBand from '../components/site/ContactBand.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string | URL;
  showContactBand?: boolean;
  sharingImage?: {
    src: string | URL;
    alt: string;
  };
}

const { title, description, canonical, sharingImage, showContactBand = true } = Astro.props;
const pageTitle = title === site.name ? title : `${title} | ${site.name}`;
const canonicalUrl = canonical ?? (Astro.site && new URL(Astro.url.pathname, Astro.site));
const imageUrl = sharingImage && (
  Astro.site ? new URL(sharingImage.src, Astro.site) : sharingImage.src
);
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon-v.svg" />
    <link rel="preload" href={displayFont} as="font" type="font/ttf" crossorigin="anonymous" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {sharingImage && (
      <>
        <meta property="og:image" content={imageUrl?.toString()} />
        <meta property="og:image:alt" content={sharingImage.alt} />
      </>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot name="header" />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {showContactBand && <ContactBand />}
    <slot name="footer" />
  </body>
</html>

<style>
  main {
    width: 100%;
    max-width: var(--width-content);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
  }

  .skip-link {
    position: fixed;
    inset-block-start: var(--space-4);
    inset-inline-start: var(--space-4);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    transform: translateY(calc(-100% - var(--space-8)));
    background: var(--color-text);
    color: var(--color-background);
    text-underline-offset: 0.2em;
  }

  .skip-link:focus {
    transform: none;
  }
</style>
