---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import StudioPageIntro from "../components/site/StudioPageIntro.astro";
import ArrowIcon from "../components/ui/ArrowIcon.astro";
import { site } from "../config/site";
---

<BaseLayout
  title="Contact"
  description="Get in touch with VomerLabs about a project, a problem, or an idea. A short email is enough."
  showContactBand={false}
>
  <SiteHeader slot="header" />
  <StudioPageIntro
    label="GET IN TOUCH"
    description="A project you’re working on, a problem that’s getting in the way, or an idea you’d like to build. A short email is enough."
  >
    Let’s make
    <br />
    something useful.
  </StudioPageIntro>
  <div class="contact-content">
    <section class="contact-invitation">
      <script is:inline>
        document.currentScript?.parentElement?.setAttribute("data-copy-js", "");
      </script>
      <h2>Start with a hello.</h2>
      <p>
        Tell me what you have in mind, who it’s for, and where you are in the
        process. We can go from there.
      </p>
      <a class="email-link" href={`mailto:${site.email}`}>
        {site.email}
        <span class="arrow">
          <ArrowIcon />
        </span>
      </a>
      <p class="email-fallback">
        <span>Prefer to copy it?</span>
        <span class="copy-address">{site.email}</span>
        <button
          class="copy-link"
          type="button"
          data-copy-email={site.email}
          aria-label={`Click here to copy ${site.email} to the clipboard`}
        >
          Click here
          <span class="arrow">
            <ArrowIcon />
          </span>
        </button>
      </p>
      <p class="email-help" data-copy-status role="status" aria-atomic="true">
        This opens your email app. You can also copy the address into your
        preferred email service.
      </p>
    </section>
    <aside class="contact-aside">
      <span class="eyebrow">A USEFUL STARTING POINT</span>
      <h2>A little context helps.</h2>
      <ul class="conversation-prompts" role="list">
        <li>
          <p>What are you trying to build or improve?</p>
        </li>
        <li>
          <p>Who will use it?</p>
        </li>
        <li>
          <p>Do you have a timeline in mind?</p>
        </li>
        <li>
          <p>What have you tried so far?</p>
        </li>
      </ul>
      <p class="closing-note">A QUESTION IS A GOOD START, TOO.</p>
    </aside>
  </div>
  <SiteFooter slot="footer" showDivider />
</BaseLayout>

<style>
  .contact-content :is(h2, p) {
    margin: 0;
  }

  .contact-content h2 {
    font-weight: 700;
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tightest);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: var(--font-size-caption);
    letter-spacing: var(--letter-spacing-label);
    line-height: var(--line-height-normal);
  }

  .eyebrow {
    display: block;
    margin-bottom: 30px;
    color: var(--color-text-muted);
  }

  .contact-content {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: var(--layout-column-gap);
    padding-block: var(--layout-section-padding);
  }

  .contact-invitation {
    min-width: 0;
    max-width: 700px;
    color: var(--color-text-prose);
    font-size: var(--font-size-body);
    line-height: var(--line-height-prose);
    overflow-wrap: anywhere;
  }

  .contact-invitation h2 {
    color: var(--color-text);
    font-size: var(--font-size-subheading);
    line-height: var(--line-height-snug);
    margin-bottom: 18px;
  }

  .contact-invitation p {
    margin-bottom: var(--space-prose);
  }

  .email-link {
    font-size: clamp(1.125rem, 2.7vw, 1.9375rem);
    display: inline-flex;
    align-items: center;
    gap: 20px;
    border-bottom: 1px solid var(--color-text);
    margin-block: 18px;
    overflow-wrap: anywhere;
    color: var(--color-text);
    text-decoration: none;
  }

  .contact-aside {
    position: sticky;
    top: var(--panel-sticky-offset);
    background: var(--color-surface-tinted);
    padding: var(--panel-padding);
    align-self: start;
  }

  .conversation-prompts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .conversation-prompts li {
    display: flex;
    align-items: baseline;
    gap: 20px;
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border-tinted);
  }

  .conversation-prompts li::before {
    content: "";
    flex-shrink: 0;
    align-self: flex-start;
    width: 0.375rem;
    height: 0.375rem;
    margin-block-start: 0.4rem;
    border-radius: 50%;
    background: var(--color-text-tinted);
  }

  .conversation-prompts p {
    min-width: 0;
    font-size: var(--font-size-body);
    font-weight: 700;
    line-height: var(--line-height-compact);
    letter-spacing: var(--letter-spacing-compact);
  }

  .contact-aside .closing-note {
    margin-top: 30px;
    color: var(--color-text-tinted-muted);
    font-size: var(--font-size-caption);
  }

  .arrow {
    display: flex;
    flex-shrink: 0;
    transform: rotate(-45deg);
  }

  .email-fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35em 0.5em;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-small);
  }

  .copy-address {
    overflow-wrap: anywhere;
  }

  .copy-link {
    display: none;
    align-items: center;
    gap: 0.4em;
    padding: 0.15em 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font-family: var(--font-sans);
    font-size: var(--font-size-body);
    line-height: var(--line-height-snug);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }

  .copy-link:is(:hover, :focus-visible) {
    text-decoration-thickness: 2px;
  }

  .contact-invitation[data-copy-js] .copy-link {
    display: inline-flex;
  }

  .contact-invitation[data-copy-js] .copy-address {
    display: none;
  }

  .contact-aside h2 {
    font-size: var(--font-size-subtitle);
    line-height: var(--line-height-heading);
  }

  @media (max-width: 900px) {
    .contact-content {
      gap: var(--layout-column-gap-medium);
    }
  }

  @media (max-width: 650px) {
    .contact-content {
      grid-template-columns: 1fr;
      padding-block: var(--layout-section-padding-small);
      gap: var(--layout-column-gap-small);
    }

    .contact-invitation {
      font-size: var(--font-size-compact);
      line-height: var(--line-height-prose-small);
    }

    .contact-invitation h2 {
      font-size: var(--font-size-subheading-small);
    }

    .contact-aside {
      position: static;
      padding: var(--panel-padding-small);
    }

    .contact-aside h2 {
      font-size: var(--font-size-subtitle-small);
    }
  }
</style>

<script>
  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");

  if (copyButton && copyStatus) {
    const email = copyButton.dataset.copyEmail ?? "";
    const defaultStatus = copyStatus.textContent?.trim() ?? "";
    let resetTimer: number | undefined;

    const copyText = async (text: string) => {
      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {
        // Fall through to the selection-based fallback.
      }

      try {
        const field = document.createElement("textarea");
        field.value = text;
        field.setAttribute("readonly", "");
        field.style.position = "fixed";
        field.style.top = "0";
        field.style.left = "0";
        field.style.opacity = "0";
        document.body.append(field);

        try {
          field.select();
          field.setSelectionRange(0, field.value.length);
          // Legacy fallback for browsers without the Clipboard API.
          const legacyDocument = document as unknown as {
            execCommand(commandId: string): boolean;
          };
          return legacyDocument.execCommand("copy");
        } finally {
          field.remove();
        }
      } catch {
        return false;
      }
    };

    copyButton.addEventListener("click", async () => {
      if (!email) {
        return;
      }

      window.clearTimeout(resetTimer);
      const copied = await copyText(email);

      if (copied) {
        copyStatus.textContent = "Copied to clipboard.";
        resetTimer = window.setTimeout(() => {
          copyStatus.textContent = defaultStatus;
        }, 2500);
      } else {
        copyStatus.textContent = `Couldn’t copy. Email ${email}.`;
      }
    });
  }
</script>
