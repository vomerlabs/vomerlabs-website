---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/site/SiteHeader.astro";
import SiteFooter from "../../components/site/SiteFooter.astro";
import Prose from "../../components/content/Prose.astro";
import FormattedDate from "../../components/content/FormattedDate.astro";
import ActionLink from "../../components/ui/ActionLink.astro";
import ArrowIcon from "../../components/ui/ArrowIcon.astro";
import { getProjects, getPublishedLabNotes } from "../../lib/content";
import { estimateReadingTime } from "../../lib/reading-time";

export const getStaticPaths = (async () => {
  const notes = await getPublishedLabNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { note } = Astro.props;
const { data } = note;
const { Content } = await render(note);
const readingTime = estimateReadingTime(note.body);
const relatedIds = new Set(data.relatedProjects.map(({ id }) => id));
const relatedProjects =
  relatedIds.size > 0
    ? (await getProjects()).filter((project) => relatedIds.has(project.id))
    : [];
---

<BaseLayout title={data.title} description={data.description}>
  <SiteHeader slot="header" />
  <article class="note" aria-labelledby="note-title">
    <header class="introduction">
      <a class="back-link" href="/lab-notes/"
        ><span class="back-arrow"><ArrowIcon /></span><span>All Lab Notes</span
        ></a
      >
      <h1 id="note-title">{data.title}</h1>
      <p class="description">{data.description}</p>
      <dl class="metadata">
        <div>
          <dt>Published</dt>
          <dd><FormattedDate date={data.publishedAt} /></dd>
        </div>
        {data.updatedAt && (
          <div>
            <dt>Updated</dt>
            <dd><FormattedDate date={data.updatedAt} /></dd>
          </div>
        )}
        {data.tags.length > 0 && (
          <div>
            <dt>Topics</dt>
            <dd>{data.tags.join(" · ")}</dd>
          </div>
        )}
        {readingTime && (
          <div>
            <dt>Reading time</dt>
            <dd>{readingTime} min read</dd>
          </div>
        )}
      </dl>
    </header>
    {
      data.coverImage && (
        <div class="cover">
          <Image
            src={data.coverImage}
            alt={data.coverImageAlt!}
            layout="full-width"
          />
        </div>
      )
    }
    <div class="note-reading">
      <div class="reading-column">
        <div class="body-content">
          <Prose variant="article"><Content /></Prose>
        </div>
        {
          relatedProjects.length > 0 && (
            <section class="related-projects" aria-labelledby="related-title">
              <h2 id="related-title">
                {relatedProjects.length === 1
                  ? "Related project"
                  : "Related projects"}
              </h2>
              <ul>
                {relatedProjects.map((project) => (
                  <li>
                    <ActionLink href={`/projects/${project.id}/`} variant="text">
                      {project.data.title}
                    </ActionLink>
                    <p>{project.data.description}</p>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <nav class="reading-footer" aria-label="After this note">
          <ActionLink href="/lab-notes/" variant="text"
            >Back to Lab Notes</ActionLink
          >
        </nav>
      </div>
    </div>
  </article>
  <SiteFooter slot="footer" topHref="#note-title" />
</BaseLayout>

<style>
  .note {
    min-width: 0;
  }

  .introduction {
    padding-block: var(--space-12);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--color-text-muted);
    text-underline-offset: 0.3em;
  }

  .back-link:hover {
    color: var(--color-text);
  }

  .back-arrow {
    display: flex;
    transform: rotate(180deg);
  }

  h1 {
    max-width: 20ch;
    margin-block: var(--space-6) var(--space-4);
    font-size: var(--font-size-detail-title);
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-tightest);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .description {
    max-width: 52ch;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-intro);
    line-height: var(--line-height-compact);
  }

  .metadata {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
    margin: var(--space-6) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-normal);
    font-variant-numeric: tabular-nums;
  }

  .metadata div {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    min-width: 0;
  }

  dd {
    margin: 0;
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
    color: var(--color-text);
  }

  .cover {
    margin-block-end: var(--space-12);
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .note-reading {
    padding-block: var(--space-12) var(--space-16);
    border-block-start: 1px solid var(--color-border);
  }

  .reading-column {
    width: 100%;
    max-width: var(--width-prose);
    min-width: 0;
    margin-inline: auto;
    font-size: var(--font-size-body);
  }

  .reading-column :global(.prose) {
    max-width: 100%;
  }

  .related-projects {
    font-size: var(--font-size-body-large);
    margin-block-start: var(--space-12);
    padding-block-start: var(--space-8);
    border-block-start: 1px solid var(--color-border);
  }

  .related-projects h2 {
    margin: 0 0 var(--space-6);
    font-size: var(--font-size-section-title);
    line-height: var(--line-height-heading);
  }

  .related-projects ul {
    display: grid;
    gap: var(--space-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related-projects p {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }

  .reading-footer {
    margin-block-start: var(--space-12);
  }
</style>
