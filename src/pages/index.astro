---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import HomepageNotes from "../components/home/HomepageNotes.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import ActionLink from "../components/ui/ActionLink.astro";
import Button from "../components/ui/Button.astro";
import { getFeaturedProjects, getPublishedLabNotes } from "../lib/content";
import { site } from "../config/site";

const featuredProjects = await getFeaturedProjects();
const notes = (await getPublishedLabNotes()).slice(0, 3);
---

<BaseLayout title={site.name} description={site.description}>
  <SiteHeader slot="header" />
  <div class="homepage">
    <section class="home-hero">
      <div class="hero-heading">
        <h1>Ideas into<br /><span>useful things.</span></h1>
        <div
          class="process-graphic"
          role="img"
          aria-label="Think, build, and share: a connected process"
        >
          <svg viewBox="0 0 320 180" fill="none" aria-hidden="true"
            ><path
              d="M60 88H260M70 97C90 165 230 165 250 97"
              stroke="currentColor"
              stroke-width="1"></path><circle
              cx="60"
              cy="88"
              r="25"
              fill="var(--color-background)"
              stroke="currentColor"></circle><circle
              cx="160"
              cy="88"
              r="25"
              fill="var(--color-accent)"></circle><circle
              cx="260"
              cy="88"
              r="25"
              fill="var(--color-background)"
              stroke="currentColor"></circle><path
              d="M51 88h18m-9-9v18M151 88l6 6 13-15M252 88h16m-6-6 6 6-6 6"
              stroke="var(--color-text)"
              stroke-width="2"></path><path
              d="M151 88l6 6 13-15"
              stroke="var(--color-text)"
              stroke-width="2"></path></svg
          ><div><span>Think</span><span>Build</span><span>Share</span></div>
        </div>
      </div>
      <div class="hero-summary">
        <p class="home-lead">{site.description}</p>
        <Button class="home-action" href="/projects/" variant="primary"
          >Explore projects</Button
        >
      </div>
    </section>
    <FeaturedProjects projects={featuredProjects} />
    <section class="home-studio">
      <h2>One curious mind, plenty to build.</h2>
      <div>
        <p>
          VomerLabs is my space to follow an idea, make something of it, and
          share the process. I build software that makes everyday work a little
          easier, and I test practical uses for AI along the way. The projects
          and notes show what works today and what still needs work.
        </p>
        <ActionLink class="home-link" href="/about/" variant="text">More about the lab</ActionLink>
      </div>
    </section>
    <HomepageNotes notes={notes} />
  </div>
  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .homepage {
    color: var(--color-text);
    background: var(--color-background);
    padding-block-end: var(--space-4);
  }
  .homepage h2 {
    margin: 0;
    font-size: var(--font-size-heading);
    line-height: var(--line-height-heading);
    letter-spacing: var(--letter-spacing-heading);
    text-wrap: balance;
  }
  .homepage p {
    margin: 0;
    max-width: 65ch;
  }
  .homepage svg {
    flex-shrink: 0;
  }
  .homepage ::selection {
    color: var(--color-text);
    background: var(--color-accent);
  }
  .home-lead {
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.125rem);
    font-weight: 400;
    line-height: var(--line-height-body);
    letter-spacing: normal;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }
  .home-studio {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    padding: var(--space-14) 0;
  }
  .home-studio p {
    font-size: 1.0625rem;
    line-height: var(--line-height-relaxed);
    color: var(--color-text-muted);
  }
  .home-studio :global(.home-link) {
    margin-top: var(--space-4);
  }
  .homepage :global(.home-notes) {
    border-top: 1px solid var(--color-border);
  }
  .home-hero {
    padding-block: var(--space-16) var(--space-14);
  }
  .hero-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.85fr);
    gap: var(--space-12);
    align-items: center;
  }
  .home-hero h1 {
    margin: 0;
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    font-weight: 700;
    line-height: var(--line-height-tight);
    letter-spacing: var(--letter-spacing-heading);
    text-wrap: balance;
  }
  .hero-summary {
    margin-top: var(--space-8);
  }
  .hero-summary .home-lead {
    max-width: 55ch;
  }
  .hero-summary .home-action {
    margin-top: 1.75rem;
  }
  .process-graphic {
    max-width: 16.25rem;
    width: 100%;
    justify-self: center;
    color: var(--color-text-muted);
  }
  .process-graphic > svg {
    display: block;
    width: 100%;
  }
  .process-graphic > div {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-1);
    margin: -0.75rem 0 0;
    font-size: var(--font-size-body);
    line-height: var(--line-height-compact);
    text-align: center;
    color: var(--color-text-muted);
  }
  .homepage :global(.home-notes a) {
    color: var(--color-text);
  }
  @media (max-width: 700px) {
    .home-studio {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-10);
    }
    .home-hero {
      padding-block: var(--space-10);
    }
    .hero-heading {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    .hero-summary {
      margin-top: var(--space-8);
    }
    .process-graphic {
      justify-self: center;
      max-width: 13.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .homepage * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
